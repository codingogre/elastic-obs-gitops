                      "workflow-d4e5f6a7-b8c9-0123-defa-345678901234"
                    ]
                  }
                }
              },
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "ids": {
                    "description": "Array of workflow IDs to delete.",
                    "items": {
                      "description": "Workflow ID to delete.",
                      "type": "string"
                    },
                    "maxItems": 1000,
                    "type": "array"
                  }
                },
                "required": [
                  "ids"
                ]
              }
            }
          }
        },
