{
  "request": {
    "method": "PUT",
    "path": "/s/gitops-dev/api/alerting/v2/rules/gitops-probe-api-rule",
    "body": {
      "kind": "alert",
      "metadata": {
        "name": "gitops-probe-api rule (policy probe)",
        "description": "Temporary probe object. Safe to delete.",
