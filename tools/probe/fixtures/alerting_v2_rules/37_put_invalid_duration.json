      },
      "recovery_strategy": "no_breach",
      "state_transition": {
        "pending_count": 0,
        "recovering_count": 0
      }
    }
  },
  "response": {
    "status": 400,
    "body": {
      "code": "BAD_REQUEST",
      "error": "Bad Request",
      "message": "[request body]: schedule.every: Invalid duration \"1 minute\". Expected format like \"5m\", \"1h\", \"30s\", \"250ms\"",
      "details": {
        "source": "body"
      }
    },
    "elapsed_seconds": 0.28
  },
  "note": "Invalid duration format"
}
