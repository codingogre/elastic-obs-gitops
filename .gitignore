.terraform.lock.hcl
tools/capture/scratch/imports.tf

# Provider filesystem mirror built locally or in CI
.terraform.d/
.provider-mirror/

# Python
.venv/
__pycache__/
*.pyc

# OS and editors
.DS_Store
.idea/
.vscode/
